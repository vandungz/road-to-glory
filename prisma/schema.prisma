// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model GameSession {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  formation    String         @default("4-3-3")
  createdAt    DateTime       @default(now())
  squadRating  Int?
  status       String         @default("in_progress") // "in_progress" | "completed"
  userId       String         // Supabase User ID
  players      CareerPlayer[]

  @@map("game_sessions")
}

model CareerPlayer {
  id                String      @id @default(uuid()) @db.Uuid
  gameSessionId     String      @db.Uuid
  gameSession       GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  slotIndex         Int         // 0 to 10 representing position in formation

  // Identity
  name              String
  nationality       String
  position          String      // GK, LB, CB, RB, CDM, CM, CAM, LW, ST, RW
  height            Int
  weight            Int         @default(75) // kg — roll qua wheel lúc debut, phụ thuộc height
  preferredFoot     String      // "Right" | "Left" | "Both"

  // Career Arc
  debutAge          Int
  retireAge         Int
  careerLengthYears Int

  // Stats & Rarity
  debutOvr          Int
  peakOvr           Int
  cardRarity        String      // bronze, silver, gold, rare_gold, epic, legendary
  currentContinentalCup String @default("none") // "UCL" | "UEL" | "UECL" | "Libertadores" | "AFC_CL" | "CONCACAF_CC" | "CAF_CL" | "none"

  // Contract & transfer economy (€ nghìn)
  contractYearsTotal    Int         @default(3)
  contractYearsRemaining Int        @default(3)
  currentWageAnnual     Int         @default(0) // € thousands / year
  marketValue           Int         @default(0) // € thousands, cached
  isUnemployed          Boolean     @default(false) // FA không ký — mùa 0 apps

  // Wallet & Influence (docs/core-currency-shop-design.md §7)
  walletBalance     Int         @default(0)      // € thousands — cumulative, server-authoritative
  influenceScore    Int         @default(0)      // 0–100, cached, derived each season checkpoint
  walletLedger      Json        @default("[]")   // Array<{ age, type, amount, label }>
  shopInventory     Json        @default("[]")   // Array<{ itemId, purchasedAtAge, appliedSeason, consumed }> — unused until Wave 2

  // Timelines & Logs (Stored as JSON)
  statsTimeline     Json        // Array of StatsSnapshot: { age, ovr, pac, sho, pas, dri, def, phy, ... }
  clubStints        Json        // Array of ClubStint: { clubId, clubName, leagueId, leagueName, startAge, endAge, yearsAtClub, ovrAtJoining, ovrAtLeaving }
  events            Json        // Array of CareerEvent: { type, label, age, clubId, nationality }
  hiddenStats       Json        // HiddenStats: { personality, professionalism, luckRating } (Server-only)
  achievements      Json?       // Cumulative trophies object: { ballonDor, trophies[], seasonAwards[] }
  seasonHistory     Json        @default("{}") // Record<age, SeasonRecord> — persisted for resume
  isRetired         Boolean     @default(false)

  // V2 persistence projection. Nullable progress fields preserve compatibility
  // with existing rows until the resumable backfill is run.
  currentAge         Int?
  currentStep        String?
  currentWheel       String?
  checkpointVersion  Int         @default(1)
  revision           Int         @default(0)
  lastCheckpointId   String?     @db.Uuid
  lastCheckpointAt   DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  seasons            CareerSeason[]
  wheelCheckpoints   WheelCheckpoint[]
  careerEvents       CareerEvent[]
  commands           CareerCommand[]

  @@unique([gameSessionId, slotIndex])
  @@map("career_players")
}

model CareerSeason {
  id              String            @id @default(uuid()) @db.Uuid
  careerPlayerId  String            @db.Uuid
  careerPlayer    CareerPlayer      @relation(fields: [careerPlayerId], references: [id], onDelete: Cascade)
  seasonNumber    Int
  age             Int
  clubId          String?
  clubName        String?
  leagueId        String?
  leagueName      String?
  status          String            @default("in_progress") // in_progress | completed | retired
  runtimeState    Json              @default("{}")
  summary         Json?
  startedAt       DateTime          @default(now())
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  wheelCheckpoints WheelCheckpoint[]
  events          CareerEvent[]
  commands        CareerCommand[]

  @@unique([careerPlayerId, seasonNumber])
  @@index([careerPlayerId, status])
  @@index([careerPlayerId, age])
  @@map("career_seasons")
}

model WheelCheckpoint {
  id              String       @id @default(uuid()) @db.Uuid
  careerPlayerId  String       @db.Uuid
  careerPlayer    CareerPlayer @relation(fields: [careerPlayerId], references: [id], onDelete: Cascade)
  seasonId        String       @db.Uuid
  season          CareerSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  stepKey         String
  wheelType       String
  resolverVersion String
  input           Json?
  outcome         Json
  publicResult    Json?
  revisionBefore  Int
  revisionAfter   Int
  idempotencyKey  String
  createdAt       DateTime     @default(now())

  // Growth wheels repeat the same logical step (selector/magnitude). The
  // revision identifies the concrete wheel occurrence for idempotency.
  @@unique([careerPlayerId, seasonId, stepKey, revisionBefore])
  @@unique([careerPlayerId, idempotencyKey])
  @@index([careerPlayerId, createdAt])
  @@index([seasonId, createdAt])
  @@map("wheel_checkpoints")
}

model CareerEvent {
  id             String        @id @default(uuid()) @db.Uuid
  careerPlayerId String        @db.Uuid
  careerPlayer   CareerPlayer  @relation(fields: [careerPlayerId], references: [id], onDelete: Cascade)
  seasonId       String?       @db.Uuid
  season         CareerSeason? @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  type           String
  label          String
  payload        Json?
  createdAt      DateTime      @default(now())

  @@index([careerPlayerId, createdAt])
  @@index([seasonId, createdAt])
  @@map("career_events")
}

model CareerCommand {
  id              String        @id @default(uuid()) @db.Uuid
  careerPlayerId  String        @db.Uuid
  careerPlayer    CareerPlayer  @relation(fields: [careerPlayerId], references: [id], onDelete: Cascade)
  seasonId        String?       @db.Uuid
  season          CareerSeason? @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  commandType     String
  idempotencyKey  String
  input           Json?
  result          Json
  revisionBefore  Int
  revisionAfter   Int
  createdAt       DateTime      @default(now())

  @@unique([careerPlayerId, idempotencyKey])
  @@index([careerPlayerId, commandType, createdAt])
  @@map("career_commands")
}

model League {
  id              String   @id // e.g., "ENG1", "ESP1"
  name            String
  country         String
  tier            Int      // 1 or 2
  prestige        Int      // 1 to 5 stars
  domesticCupName String   @default("Cup Quốc Gia")
  confederation   String   @default("UEFA") // UEFA | CONMEBOL | CONCACAF | AFC | CAF
  clubs           Club[]

  @@map("leagues")
}

model NationalTeam {
  id            String @id // e.g., "england", "france"
  name          String // Tên hiển thị tiếng Việt: "Anh", "Pháp"
  nationality   String @unique // Key tiếng Anh khớp với CareerPlayer.nationality
  confederation String // "UEFA" | "CONMEBOL" | "AFC" | "CAF" | "CONCACAF"
  tier          Int    // 1 = Tier 1, 2 = Tier 2, 3 = Tier 3

  @@map("national_teams")
}

model Club {
  id                     String   @id // e.g., "real_madrid", "man_city"
  name                   String
  leagueId               String
  league                 League   @relation(fields: [leagueId], references: [id])
  prestige               Int      // 1 to 5 stars
  leagueTitlesCount      Int      @default(0)
  domesticCupsCount      Int      @default(0)
  continentalTitlesCount Int      @default(0)
  continentalType        String   @default("none") // "UCL" | "UEL" | "UECL" | "Libertadores" | "Sudamericana" | "AFC_CL" | "CONCACAF_CC" | "CAF_CL" | "none"

  @@map("clubs")
}

// Development-only reusable fixtures. These are cloned into an authenticated
// user's own GameSession by a guarded dev action; they are never gameplay truth.
