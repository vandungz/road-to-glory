# Runtime connection only. Use a least-privilege application role and the
# Supabase pooler connection string copied from the Connect dialog.
DATABASE_URL="postgresql://football_life_runtime.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres?sslmode=require"

# Migration-only connection. Copy the exact migration/admin connection from
# Supabase Connect. On the Free plan, a shared session pooler connection may
# be the practical IPv4 option when the direct database host is IPv6-only.
# Do not deploy this credential to browser code or normal app runtime.
DIRECT_URL="postgresql://[SUPABASE_ADMIN_USER]:[PASSWORD]@[MIGRATION_HOST]:5432/postgres?sslmode=require"

# Public Supabase client configuration. RLS must remain enabled in production.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-supabase-anon-key"

# Canonical HTTPS origin used for auth redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Required for production distributed rate limiting.
UPSTASH_REDIS_REST_URL="https://[UPSTASH-DB].upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-token"

# Optional bounded PostgreSQL pool settings.
PG_POOL_MAX="3"
LEGACY_CAREER_WRITES="false"
PG_CONNECTION_TIMEOUT_MS="10000"
PG_IDLE_TIMEOUT_MS="30000"
PG_STATEMENT_TIMEOUT_MS="15000"
PG_QUERY_TIMEOUT_MS="20000"
PG_IDLE_IN_TRANSACTION_TIMEOUT_MS="30000"
# Optional production hardening: provide the Supabase CA or set explicit verification.
PGSSL_CA=""
PG_SSL_REJECT_UNAUTHORIZED=""
