# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/output/playwright/
/output/audio-source/
/playwright-report/
/test-results/
/.playwright-mcp/
/.hallmark/before/
/.hallmark/after/
/.hallmark/scaffold/
/.hallmark/shots/
/.hallmark/*.png
/.hallmark/*.html
/*-baseline.log

# next.js
/.next/
/.next-dev/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
/graphify-out/
/.hallmark/
